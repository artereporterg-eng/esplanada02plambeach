# ==============================================================================
# PÉROLA DO OCEANO - CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# Copie este ficheiro para .env e preencha as variáveis correspondentes ao provedor
# de base de dados serverless que deseja utilizar.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TURSO (LibSQL / SQLite Serverless em Edge) [Recomendado]
# Obtenha em: https://turso.tech ou através da Turso CLI (`turso db tokens create`)
# ------------------------------------------------------------------------------
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
VITE_TURSO_DATABASE_URL=
VITE_TURSO_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# 2. NEON / VERCEL POSTGRES (PostgreSQL Serverless)
# Obtenha em: https://neon.tech ou painel da Vercel Storage
# Exemplo: postgresql://usuario:senha@ep-xyz.eu-west-1.neon.tech/neondb?sslmode=require
# ------------------------------------------------------------------------------
DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. SUPABASE (PostgreSQL Cloud com PostgREST)
# Obtenha em: https://supabase.com (Project Settings -> API)
# ------------------------------------------------------------------------------
SUPABASE_URL="https://fatzojokocvslmhoxfid.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZhdHpvam9rb2N2c2xtaG94ZmlkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODkwMjY3NDIsImV4cCI6MjEwNDYwMjc0Mn0.svV4JBrzbMbszaKj5y0CMbOe82pcMrdwmS9P80kTm5M"
VITE_SUPABASE_URL="https://fatzojokocvslmhoxfid.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZhdHpvam9rb2N2c2xtaG94ZmlkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODkwMjY3NDIsImV4cCI6MjEwNDYwMjc0Mn0.svV4JBrzbMbszaKj5y0CMbOe82pcMrdwmS9P80kTm5M"

# ------------------------------------------------------------------------------
# 4. UPSTASH REDIS / VERCEL KV (Key-Value REST Serverless)
# Obtenha em: https://upstash.com
# ------------------------------------------------------------------------------
